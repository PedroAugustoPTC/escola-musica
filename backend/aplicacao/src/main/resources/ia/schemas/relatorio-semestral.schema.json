{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:relatorios:schema:relatorio-semestral",
  "title": "Saída da IA para o relatório semestral (consolidação e revisão), seções 2 a 10",
  "$defs": {
    "texto": { "type": "string", "maxLength": 4000 },
    "lista": { "type": "array", "items": { "type": "string", "maxLength": 500 }, "maxItems": 30 }
  },
  "type": "object",
  "required": [
    "frequenciaEEstudo", "tecnica", "musicalidade", "leituraEMemorizacao", "pontosDeAtencao",
    "estrategiasPedagogicas", "acompanhamentoFamiliar", "planejamentoProximoSemestre", "parecerFinal"
  ],
  "properties": {
    "frequenciaEEstudo": {
      "type": "object",
      "properties": {
        "frequenciaAulas": { "$ref": "#/$defs/texto" },
        "regularidadeEstudoEmCasa": { "$ref": "#/$defs/texto" },
        "engajamento": { "$ref": "#/$defs/texto" },
        "comentarioGeral": { "$ref": "#/$defs/texto" }
      }
    },
    "tecnica": {
      "type": "object",
      "properties": {
        "conteudosTrabalhados": { "$ref": "#/$defs/lista" },
        "evolucaoTecnica": { "$ref": "#/$defs/texto" },
        "pontosADesenvolver": { "$ref": "#/$defs/lista" },
        "estudosRealizados": { "$ref": "#/$defs/lista" }
      }
    },
    "musicalidade": {
      "type": "object",
      "properties": {
        "repertorioEstudado": { "$ref": "#/$defs/lista" },
        "som": { "$ref": "#/$defs/texto" },
        "ritmo": { "$ref": "#/$defs/texto" },
        "fraseado": { "$ref": "#/$defs/texto" },
        "articulacao": { "$ref": "#/$defs/texto" },
        "estilo": { "$ref": "#/$defs/texto" },
        "comentarioMusical": { "$ref": "#/$defs/texto" }
      }
    },
    "leituraEMemorizacao": {
      "type": "object",
      "properties": {
        "avaliacao": { "$ref": "#/$defs/texto" },
        "comentario": { "$ref": "#/$defs/texto" }
      }
    },
    "pontosDeAtencao": { "type": "object", "properties": { "itens": { "$ref": "#/$defs/lista" } } },
    "estrategiasPedagogicas": { "type": "object", "properties": { "itens": { "$ref": "#/$defs/lista" } } },
    "acompanhamentoFamiliar": {
      "type": "object",
      "properties": {
        "nivelDePresenca": { "$ref": "#/$defs/texto" },
        "observacaoDoProfessor": { "$ref": "#/$defs/texto" }
      }
    },
    "planejamentoProximoSemestre": {
      "type": "object",
      "properties": {
        "metasTecnicas": { "$ref": "#/$defs/lista" },
        "metasMusicais": { "$ref": "#/$defs/lista" },
        "habitosDeEstudo": { "$ref": "#/$defs/lista" },
        "repertorioProposto": { "$ref": "#/$defs/lista" },
        "estudosTecnicos": { "$ref": "#/$defs/lista" },
        "leituraETeoria": { "$ref": "#/$defs/lista" },
        "projetoDoSemestre": { "$ref": "#/$defs/texto" }
      }
    },
    "parecerFinal": { "type": "string", "maxLength": 6000 },
    "semAlteracaoDeConteudo": { "type": "boolean" },
    "pedidoDeAcao": { "enum": ["NENHUM", "APROVAR", "CANCELAR"] }
  }
}
