<?xml version="1.0" encoding="UTF-8"?>
<!-- Logs estruturados em JSON (R-13), com mascaramento de dados sensíveis como defesa em
     profundidade (FR-055). Nunca registrar áudio, transcrição, conteúdo, nomes, CPF, código nem token. -->
<configuration>
    <springProfile name="seed">
        <!-- Comandos operacionais: só avisos e erros, em texto, para não poluir o terminal. A mensagem
             passa pelo mesmo mascaramento do perfil JSON e a exceção sai só pelo tipo (a mensagem do
             Hibernate/PostgreSQL traz valores, como Key (email)=(...)); sem pilha. -->
        <conversionRule conversionWord="maskedMsg"
                        converterClass="br.com.felipeblaft.reports.config.log.MaskedMessageConverter"/>
        <conversionRule conversionWord="exType"
                        converterClass="br.com.felipeblaft.reports.config.log.ExceptionTypeConverter"/>
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <target>System.err</target>
            <encoder>
                <pattern>%level %logger{0} - %maskedMsg%exType%n</pattern>
            </encoder>
        </appender>
        <logger name="org.hibernate.orm.jdbc.error" level="OFF"/>
        <root level="WARN">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!seed">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>reportId</includeMdcKeyName>
                <includeMdcKeyName>jobId</includeMdcKeyName>
                <includeMdcKeyName>channel</includeMdcKeyName>
                <includeMdcKeyName>step</includeMdcKeyName>
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerThrowable>20</maxDepthPerThrowable>
                    <rootCauseFirst>true</rootCauseFirst>
                </throwableConverter>
                <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                    <valueMasker class="br.com.felipeblaft.reports.config.log.SensitiveDataMaskingConverter"/>
                </jsonGeneratorDecorator>
            </encoder>
        </appender>
        <logger name="br.com.felipeblaft.reports" level="INFO"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
