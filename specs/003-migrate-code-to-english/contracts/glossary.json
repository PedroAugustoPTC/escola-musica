  "exceptions": [
    {
      "id": "org-name",
      "scope": "java:package, maven:groupId",
      "terms": [
        "br.com.felipeblaft"
      ],
      "reason": "Nome de organização (domínio reverso do Instituto Musical Felipe Blaft); o pacote base muda só no sufixo (relatorios → reports)."
    },
    {
      "id": "immutable-migrations",
      "scope": "file: backend/aplicacao/src/main/resources/db/migration/V1__* até V8__*",
      "terms": [
        "*"
      ],
      "reason": "Migrações Flyway já aplicadas são imutáveis (checksum); a V7 e a V8 contêm os nomes antigos porque são quem os renomeia. O esquema RESULTANTE é verificado pelo teste de catálogo (R-05), e V9 em diante são varridas normalmente."
    },
    {
      "id": "teacher-keywords",
      "scope": "string-literal: entrada/telegram/PalavrasChaveTelegram (→ TelegramKeywords) e seus testes",
      "terms": [
        "start",
        "inicio",
        "menu",
        "registrar aula",
        "registrar",
        "relatorio semestral",
        "semestral",
        "historico",
        "aprovar",
        "cancelar",
        "continuar",
        "descartar",
        "tentar",
        "tentar novamente",
        "sair",
        "ajuda",
        "help",
        "sim"
      ],
      "reason": "Palavras que o professor digita no bot são entrada do usuário (FR-011, constituição VI); permanecem em português, sem acento, como o reconhecedor as normaliza."
    },
    {
      "id": "vendor-font-files",
      "scope": "file: **/fontes/** e **/fonts/**",
      "terms": [
        "Cinzel",
        "CormorantGaramond",
        "SourceSans3",
        "OFL",
        "LICENSE"
      ],
      "reason": "Nomes de arquivos de fontes e de licenças de terceiros; a pasta 'fontes' passa a 'fonts', os arquivos não são renomeados."
    },
    {
      "id": "brand-prefix",
      "scope": "file: **/brand/**, **/pdf/images/**",
      "terms": [
        "fb-"
      ],
      "reason": "Prefixo 'fb' é a sigla do Instituto Musical Felipe Blaft nos ativos da marca; as cores no nome do arquivo passam a inglês (marfim → ivory)."
    },
    {
      "id": "public-domain",
      "scope": "string-literal: $id de JSON Schema e URLs públicas",
      "terms": [
        "relatorios.felipeblaft.com.br"
      ],
      "reason": "Nome de domínio público da organização; não é identificador de código. Confirmar com o dono do produto se o domínio real é este (ver plan.md, Pontos de decisão)."
    },
    {
      "id": "user-visible-text",
      "scope": "string-literal com espaço ou acento, comentários, documentação, logs",
      "terms": [
        "*"
      ],
      "reason": "Texto mostrado ao usuário, mensagens de log, comentários e documentação ficam em português (FR-023); o guardião só examina literais de uma palavra, sem espaço (identificadores, chaves, rotas)."
    },
    {
      "id": "out-of-scope-folders",
      "scope": "dir: portal-do-professor-design-system/, assets/, specs/, .claude/, .specify/templates, HANDOFF_MVP_Relatorios_Escola_Musica.md, PLANO_EXECUCAO_SPECKIT.md",
      "terms": [
        "*"
      ],
      "reason": "Material de referência do cliente, histórico de specs e documentos de planejamento; não são código de produção (FR-023). Pastas e arquivos de documentação não são renomeados."
    },
    {
      "id": "third-party-api-names",
      "scope": "qualquer",
      "terms": [
        "callback_data",
        "chat_id",
        "parse_mode",
        "file_id",
        "file_unique_id",
        "update_id",
        "X-N8N-Service-Token"
      ],
      "reason": "Nomes impostos pela API do Telegram, pelo n8n ou por ferramentas; já estão em inglês, listados só para documentar que não são tocados."
    },
    {
      "id": "temporary-per-slice",
      "scope": "preenchido durante a execução em fatias, só na branch (FR-035)",
      "terms": [],
      "reason": "Exclusões temporárias por fatia ainda não migrada. Começa com o que as fatias 2 a 7 migrarão, encolhe a cada commit e DEVE estar vazia no commit final. A main nunca recebe o guardião com esta lista preenchida."
    }
  ]
}
