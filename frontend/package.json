{
  "name": "teacher-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Portal do Professor — Relatórios Pedagógicos por Voz (Instituto Musical Felipe Blaft)",
  "scripts": {
    "generate:messages": "node scripts/generate-messages.mjs",
    "generate:api": "openapi-typescript ../specs/001-fluxo-relatorios/contracts/api-portal.openapi.yaml -o src/services/api-types.ts",
    "generate:administration-api": "openapi-typescript ../specs/005-admin-registrations-access/contracts/api-administration.openapi.yaml -o src/services/administration-api-types.ts",
    "generate:school-history-api": "openapi-typescript ../specs/006-admin-report-history/contracts/api-school-history.openapi.yaml -o src/services/school-history-api-types.ts",
    "generate": "npm run generate:messages && npm run generate:api && npm run generate:administration-api && npm run generate:school-history-api",
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run generate",
    "typecheck": "tsc -b --noEmit",
    "pretest": "npm run generate",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
