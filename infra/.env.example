# Variáveis de ambiente do Sistema de Relatórios Pedagógicos por Voz (Instituto Musical Felipe Blaft).
#
# Copie este arquivo para `infra/.env` (mesmo diretório) e preencha os valores antes de subir a pilha:
#
#   cp infra/.env.example infra/.env
#   docker compose -f infra/compose.yaml -f infra/compose.dev.yaml up -d --build
#
# O `infra/.env` NUNCA é versionado (está no .gitignore; Princípio IV: segredos só por variável de
# ambiente). Só este exemplo, sem valores reais, fica no Git. O compose usa o arquivo de dois jeitos:
# `env_file` (todas as chaves chegam ao backend) e interpolação `${...}` (postgres, Caddy e o servidor
# local da API de bots). Detalhes em infra/README.md e specs/001-fluxo-relatorios/quickstart.md §2.
#
# Vindo do MVP (mvp-relatorios/infrastructure/.env)? Correspondência das chaves:
#   TELEGRAM_BOT_TOKEN  → TELEGRAM_BOT_TOKEN (mesmo nome; faça o `logOut` do bot — veja abaixo)
#   STT_API_KEY         → TRANSCRIPTION_API_KEY
#   LLM_API_KEY         → LLM_API_KEY
#   STT_MODEL/LLM_MODEL → TRANSCRIPTION_MODEL/LLM_MODEL
#   POSTGRES_PASSWORD, CPF_ENCRYPTION_KEY → gere valores NOVOS (é outro banco)
#   JWT_SECRET, CORS_ALLOWED_ORIGIN → não existem aqui (sessão por cookie; mesma origem)
#   N8N_*  → só N8N_ENCRYPTION_KEY existe aqui; o n8n desta versão é só transporte (veja a seção do n8n abaixo)

# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL 18)
# ---------------------------------------------------------------------------
# Senha do usuário `reports` (o banco e o usuário são fixos no compose). Obrigatória.
# Gere com: openssl rand -base64 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Segurança de dados (Princípio IV)
# ---------------------------------------------------------------------------
# Chave AES-256-GCM do CPF em repouso: Base64 de exatamente 32 bytes. Obrigatória.
# Gere com: openssl rand -base64 32
# ATENÇÃO: perder esta chave torna os CPFs gravados ilegíveis; guarde-a num cofre junto dos backups.
CPF_ENCRYPTION_KEY=

# Segredo do HMAC de códigos de acesso, CPF e origens de tentativa (≥ 32 bytes). Obrigatório.
# Gere com: openssl rand -base64 48
# ATENÇÃO: trocar este valor invalida todos os códigos de acesso e o bloqueio por tentativas.
HMAC_SECRET=

# Sessão do portal (horas sem uso até expirar). Opcional — padrão 12.
#WEB_SESSION_HOURS=12
# Cookie de sessão só por HTTPS. Opcional — padrão true; não desligue fora de testes.
#SESSION_COOKIE_SECURE=true
# Tentativas incorretas de código antes do bloqueio e duração do bloqueio. Opcionais — 5 e 15.
#ACCESS_MAX_ATTEMPTS=5
#ACCESS_LOCK_MINUTES=15
# Validade do código de acesso sem uso (dias). Opcional — padrão 7.
#CODE_VALIDITY_DAYS=7

# ---------------------------------------------------------------------------
# Domínio e HTTPS (Caddy — único ponto de entrada; só 80 e 443 publicados em produção)
# ---------------------------------------------------------------------------
# Em desenvolvimento, "localhost" usa a CA interna do Caddy (o navegador pede para confiar).
# Em produção, o domínio real (DNS apontando para a VPS) obtém certificado automático.
DOMAIN=localhost
# E-mail do certificado (Let's Encrypt). Obrigatório em produção; precisa ser um e-mail válido.
ACME_EMAIL=

# ---------------------------------------------------------------------------
# Canal Telegram (servidor local da API de bots, R-05: arquivos de até 50 MB)
# ---------------------------------------------------------------------------
# true liga o bot (registro do webhook e envio de mensagens). Para usar só o portal, deixe false.
TELEGRAM_ENABLED=true

# Token do bot, obtido no @BotFather (/newbot). Obrigatório com o Telegram habilitado.
# Use um bot de TESTES fora da produção. Se o bot já foi usado na API da nuvem (ex.: no MVP com n8n),
# faça uma vez:  curl -s "https://api.telegram.org/bot<TOKEN>/logOut"
# e não rode o MVP ao mesmo tempo: dois servidores não podem atender o mesmo bot.
TELEGRAM_BOT_TOKEN=

# api_id e api_hash da SUA conta do Telegram, em https://my.telegram.org → "API development tools".
# Exigidos pelo servidor local da API de bots (o MVP não precisava deles). Obrigatórios.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Segredo do cabeçalho X-Telegram-Bot-Api-Secret-Token do webhook (1 a 256 caracteres A-Z, a-z,
# 0-9, _ e -). Obrigatório com o Telegram habilitado.
# Gere com: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Minutos que um áudio enviado ao bot espera a confirmação do aluno antes de ser descartado.
# Opcional — padrão 30.
#PENDING_AUDIO_MINUTES=30

# ---------------------------------------------------------------------------
# Provedores de IA (R-08) — APIs compatíveis com a OpenAI; padrão Groq
# ---------------------------------------------------------------------------
# "simulated" usa respostas gravadas (sem custo, sem chaves); "real" chama os provedores abaixo.
AI_PROVIDERS=simulated

# Transcrição (speech-to-text). Chave em https://console.groq.com/keys (formato gsk_...).
# Obrigatória com AI_PROVIDERS=real.
TRANSCRIPTION_URL=https://api.groq.com/openai/v1
TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_API_KEY=

# LLM (estruturação, perguntas, alterações e consolidação semestral). Pode ser a mesma chave da Groq.
# Obrigatória com AI_PROVIDERS=real. O sistema nunca envia nome, CPF ou nascimento do aluno (FR-044).
LLM_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Tabela de preços (USD) para o custo estimado registrado por chamada (FR-056). Ajuste se trocar de
# provedor ou modelo.
TRANSCRIPTION_PRICE_USD_PER_HOUR=0.04
LLM_PRICE_USD_PER_MILLION_INPUT=0.59
LLM_PRICE_USD_PER_MILLION_OUTPUT=0.79

# ---------------------------------------------------------------------------
# Limites e regras (padrões da spec; ajustáveis)
# ---------------------------------------------------------------------------
# Tamanho máximo do áudio ou vídeo enviado (MB), nos dois canais.
AUDIO_LIMIT_MB=50
# Fuso da escola: datas e horas de aulas, aprovações e semestres.
SCHOOL_TIMEZONE=America/Sao_Paulo
# Processamento em segundo plano: trabalhos simultâneos e intervalo de consulta da fila (ms).
#JOBS_WORKERS=2
#JOBS_INTERVAL_MS=500
# Porta do banco publicada em 127.0.0.1 por `local.sh database-port` (só local). Opcional — padrão 5432.
#LOCAL_DATABASE_PORT=5432

# ---------------------------------------------------------------------------
# n8n — transporte do canal Telegram (feature 004)
# ---------------------------------------------------------------------------
# O n8n sobe com a pilha (serviço `n8n` do compose), sem porta pública, com os workflows do repositório.
# Ele só recebe o que está abaixo e no bloco "Canal Telegram interno": o token do bot, os tokens do canal e
# esta chave. Com o Telegram habilitado, exige TELEGRAM_BOT_TOKEN, TELEGRAM_CHANNEL_CURRENT_TOKEN e
# TELEGRAM_CHANNEL_ORCHESTRATOR_TOKEN (três valores DIFERENTES entre si) além da chave abaixo.
# Chave de cifra da instância do n8n. Obrigatória com o Telegram habilitado. Gere com: openssl rand -hex 32
# ATENÇÃO: o n8n não guarda dado de domínio nem credencial; trocar a chave só invalida o que ele cifrou (nada).
N8N_ENCRYPTION_KEY=
# SEGREDO NÃO: estado do transporte, escrito por `infra/scripts/telegram-webhook.sh` — NÃO edite à mão.
# DIRECT (padrão: o webhook é o do backend) ou N8N (o n8n é o transporte).
#TELEGRAM_TRANSPORT=DIRECT
# Chat de teste do mantenedor para a ida e volta real do `telegram-webhook.sh verify`. Opcional.
#TELEGRAM_VERIFY_CHAT_ID=

# ---------------------------------------------------------------------------
# Canal Telegram interno (feature 002) — API para o orquestrador (n8n)
# ---------------------------------------------------------------------------
# Quem entrega as mensagens proativas: DIRECT (API de bots, padrão) ou ORCHESTRATOR (outbox -> n8n).
#TELEGRAM_CHANNEL_DELIVERY=DIRECT
# SEGREDOS: tokens de serviço aceitos em X-N8N-Service-Token (dois para rotação sem indisponibilidade).
# Vazios = a área /internal/** recusa tudo. Gere com `openssl rand -base64 32`.
#TELEGRAM_CHANNEL_CURRENT_TOKEN=
#TELEGRAM_CHANNEL_NEXT_TOKEN=
# Webhook do n8n que recebe os lotes proativos (obrigatório com TELEGRAM_CHANNEL_DELIVERY=ORCHESTRATOR; quem
# liga isso é `telegram-webhook.sh switch`, que usa http://n8n:5678/webhook/channel-delivery) e o SEGREDO enviado
# em X-Channel-Delivery-Token (o n8n confere o mesmo valor). A URL nunca é registrada em log.
#TELEGRAM_CHANNEL_ORCHESTRATOR_URL=
#TELEGRAM_CHANNEL_ORCHESTRATOR_TOKEN=
# Cliente HTTP (ms) e retentativa (s): 30 s, 1, 2, 4... até o teto de 15 min, por até 24 h.
#TELEGRAM_CHANNEL_CONNECTION_TIMEOUT_MS=3000
#TELEGRAM_CHANNEL_RESPONSE_TIMEOUT_MS=10000   # o compose fixa 30000: o n8n só aceita o lote depois de executá-lo
#TELEGRAM_CHANNEL_RETRY_INITIAL_S=30
#TELEGRAM_CHANNEL_RETRY_CEILING_S=900
#TELEGRAM_CHANNEL_DEADLINE_H=24
# Portão de ordem por chat (s) e reserva do lote (s; deve exceder conexão + resposta).
#TELEGRAM_CHANNEL_CONFIRMATION_MAX_S=60
#TELEGRAM_CHANNEL_LEASE_S=60
# Despachante: intervalo (ms) e máximo de lotes por ciclo.
#TELEGRAM_CHANNEL_DISPATCH_INTERVAL_MS=2000
#TELEGRAM_CHANNEL_BATCH_MAX=20
# Retenção da outbox: conteúdo das ações (h) e registro (dias).
#TELEGRAM_CHANNEL_PAYLOAD_RETENTION_H=24
#TELEGRAM_CHANNEL_RECORD_RETENTION_D=7

# ---------------------------------------------------------------------------
# Já definidos pelo compose — só mexa se rodar o backend fora dele (ex.: `java -jar` local)
# ---------------------------------------------------------------------------
#DATABASE_URL=jdbc:postgresql://localhost:5432/reports
#DATABASE_USER=reports
#DATABASE_PASSWORD=
#TELEGRAM_API_URL=http://telegram-bot-api:8081
#TELEGRAM_WEBHOOK_URL=http://backend:8080/telegram/webhook   # o compose usa este valor se a chave não existir
#TELEGRAM_FILES_DIR=/var/lib/telegram-bot-api
#DOCUMENTS_DIR=/data/documents
#AUDIO_TEMP_DIR=/tmp/audios
