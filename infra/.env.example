# Copie para infra/.env (nunca versionado) e preencha os segredos. Ver quickstart.md §2.

# Banco
POSTGRES_PASSWORD=

# Segurança de dados (Princípio IV)
# Base64 de 32 bytes aleatórios (AES-256-GCM): openssl rand -base64 32
CPF_CHAVE_CIFRAGEM=
# Segredo do HMAC de códigos de acesso, CPF e origens (≥ 32 bytes): openssl rand -base64 48
SEGREDO_HMAC=

# Domínio público (produção). Em dev, "localhost" usa a CA interna do Caddy.
DOMINIO=localhost
ACME_EMAIL=

# Canal Telegram (servidor local da API de bots, R-05)
TELEGRAM_HABILITADO=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Segredo do cabeçalho X-Telegram-Bot-Api-Secret-Token (1 a 256 caracteres A-Z, a-z, 0-9, _ e -)
TELEGRAM_SEGREDO_WEBHOOK=

# Provedores de IA (R-08): "real" ou "simulado"
PROVEDORES_IA=simulado
TRANSCRICAO_URL=https://api.groq.com/openai/v1
TRANSCRICAO_MODELO=whisper-large-v3-turbo
TRANSCRICAO_CHAVE=
LLM_URL=https://api.groq.com/openai/v1
LLM_MODELO=llama-3.3-70b-versatile
LLM_CHAVE=
# Tabela de preços (USD) para o custo estimado (FR-056)
TRANSCRICAO_PRECO_USD_POR_HORA=0.04
LLM_PRECO_USD_POR_MILHAO_ENTRADA=0.59
LLM_PRECO_USD_POR_MILHAO_SAIDA=0.79

# Limites e regras (padrões da spec; ajustáveis)
AUDIO_LIMITE_MB=50
SESSAO_WEB_HORAS=12
ACESSO_MAX_TENTATIVAS=5
ACESSO_BLOQUEIO_MINUTOS=15
CODIGO_VALIDADE_DIAS=7
AUDIO_PENDENTE_MINUTOS=30
ESCOLA_FUSO_HORARIO=America/Sao_Paulo
