{
  "id": "telegram-inbound",
  "name": "telegram-inbound",
  "nodes": [
    {
      "id": "webhook-1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram-update",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "webhookId": "telegram-update"
    },
    {
      "id": "forward-2",
      "name": "Forward",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.BACKEND_INTERNAL_URL }}/internal/v1/channel/telegram/update",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Service-Token",
              "value": "={{ $env.BACKEND_SERVICE_TOKEN }}"
            },
            {
              "name": "X-Telegram-Bot-Api-Secret-Token",
              "value": "={{ $json.headers['x-telegram-bot-api-secret-token'] }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "autodetect"
            }
          },
          "timeout": 25000
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "isok-4",
      "name": "IsOk",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "condition-3",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "run-5",
      "name": "Run",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.1,
      "position": [
        720,
        -160
      ],
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "value": "execute-actions",
          "mode": "id"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      }
    },
    {
      "id": "succeeded-7",
      "name": "Succeeded",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        -160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "condition-6",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ok200-8",
      "name": "Ok200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        -320
      ],
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "fail503-9",
      "name": "Fail503",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        160
      ],
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 503
        }
      }
    },
    {
      "id": "livewebhook-10",
      "name": "LiveWebhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        640
      ],
      "parameters": {
        "httpMethod": "GET",
        "path": "telegram-inbound/live",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "telegram-inbound-live"
    },
    {
      "id": "liverespond-11",
      "name": "LiveRespond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        240,
        640
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"UP\"}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Forward",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward": {
      "main": [
        [
          {
            "node": "IsOk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IsOk": {
      "main": [
        [
          {
            "node": "Run",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fail503",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run": {
      "main": [
        [
          {
            "node": "Succeeded",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Succeeded": {
      "main": [
        [
          {
            "node": "Ok200",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fail503",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "LiveWebhook": {
      "main": [
        [
          {
            "node": "LiveRespond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveExecutionProgress": false,
    "saveManualExecutions": false
  }
}
