        "language": "javaScript",
        "jsCode": "const action = $('Loop').item.json;\nconst rows = action.keyboard && Array.isArray(action.keyboard.rows) ? action.keyboard.rows : [];\nconst inline = rows.map((row) => row.map((button) => ({ text: button.label, callback_data: button.data })));\nif (action.type === 'CALLBACK_REPLY') {\n  return [{ json: { method: 'answerCallbackQuery', body: { callback_query_id: action.callbackId } } }];\n}\nconst base = { chat_id: action.chatId, text: action.text, parse_mode: 'HTML' };\nconst editingStep = action.type === 'STEP_MESSAGE' && action.editMessageId !== undefined && action.editMessageId !== null;\nif (action.type === 'EDIT' || editingStep) {\n  const messageId = action.type === 'EDIT' ? action.messageId : action.editMessageId;\n  return [{ json: { method: 'editMessageText', body: { ...base, message_id: messageId, reply_markup: { inline_keyboard: inline } } } }];\n}\nconst body = { ...base, link_preview_options: { is_disabled: true } };\nif (inline.length > 0) {\n  body.reply_markup = { inline_keyboard: inline };\n}\nreturn [{ json: { method: 'sendMessage', body } }];"
      }
