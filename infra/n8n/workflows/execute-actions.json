    {
      "id": "result-31",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        -160
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForEachItem",
        "jsCode": "const action = $('Loop').item.json;\nconst response = $input.item.json;\nconst reply = response.body && typeof response.body === 'object' ? response.body : {};\nconst description = typeof reply.description === 'string' ? reply.description.toLowerCase() : '';\nconst status = response.statusCode;\nlet reasonCode = null;\nif (response.error !== undefined) {\n  reasonCode = 'TELEGRAM_ERROR';\n} else if (Math.floor(status / 100) !== 2) {\n  if (description.includes('message is not modified')) {\n    reasonCode = null;\n  } else if (description.includes('message to edit not found') || description.includes(\"message can't be edited\") || description.includes('message_id_invalid')) {\n    reasonCode = 'MESSAGE_NOT_EDITABLE';\n  } else if (status === 403 || description.includes('chat not found')) {\n    reasonCode = 'CHAT_UNAVAILABLE';\n  } else if (status === 429) {\n    reasonCode = 'RATE_LIMITED';\n  } else {\n    reasonCode = 'TELEGRAM_ERROR';\n  }\n}\nconst result = { actionId: action.actionId, outcome: reasonCode === null ? 'EXECUTED' : 'FAILED' };\nif (reasonCode !== null) {\n  result.reasonCode = reasonCode;\n} else if (action.type === 'EDIT') {\n  result.messageId = action.messageId;\n} else if (action.type === 'STEP_MESSAGE' && action.editMessageId !== undefined && action.editMessageId !== null) {\n  result.messageId = action.editMessageId;\n} else if (reply.result && typeof reply.result.message_id === 'number') {\n  result.messageId = reply.result.message_id;\n}\nreturn { json: { version: 'v1', results: [result] } };"
      }
    },
