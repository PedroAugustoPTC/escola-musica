{
  "id": "transport-health",
  "name": "transport-health",
  "nodes": [
    {
      "id": "health-live-webhook",
      "name": "LiveWebhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "transport-health-live",
      "parameters": {
        "httpMethod": "GET",
        "path": "transport-health/live",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "health-live-respond",
      "name": "LiveRespond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [240, 0],
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"UP\"}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "health-deep-webhook",
      "name": "DeepWebhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 240],
      "webhookId": "transport-health-deep",
      "parameters": {
        "httpMethod": "GET",
        "path": "transport-health/deep",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "health-deep-backend",
      "name": "Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 240],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_INTERNAL_URL }}/internal/v1/channel/telegram/actions/u0-0",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-N8N-Service-Token", "value": "={{ $env.BACKEND_SERVICE_TOKEN }}" }
          ]
        },
        "options": {
          "redirect": { "redirect": { "followRedirects": false } },
          "response": { "response": { "fullResponse": true, "neverError": true, "responseFormat": "autodetect" } },
          "timeout": 5000
        }
      }
    },
    {
      "id": "health-deep-bot",
      "name": "BotApi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 240],
      "onError": "continueRegularOutput",
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TELEGRAM_API_URL }}/bot{{ $env.TELEGRAM_BOT_TOKEN }}/getMe",
        "options": {
          "redirect": { "redirect": { "followRedirects": false } },
          "response": { "response": { "fullResponse": true, "neverError": true, "responseFormat": "autodetect" } },
          "timeout": 5000
        }
      }
    },
    {
      "id": "health-deep-shape",
      "name": "Shape",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 240],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const backend = $('Backend').first().json;\nconst bot = $('BotApi').first().json;\nlet backendState = 'down';\nif (backend.error === undefined && backend.statusCode === 404) {\n  backendState = 'ok';\n} else if (backend.error === undefined && backend.statusCode === 401) {\n  backendState = 'unauthorized';\n}\nconst botState = bot.error === undefined && bot.statusCode === 200 && bot.body && bot.body.ok === true ? 'ok' : 'down';\nconst up = backendState === 'ok' && botState === 'ok';\nreturn [{ json: { ok: up, body: JSON.stringify({ status: up ? 'UP' : 'DOWN', backend: backendState, botApi: botState }) } }];"
      }
    },
    {
      "id": "health-deep-check",
      "name": "IsUp",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 240],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "health-deep-condition",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "health-deep-up",
      "name": "DeepUp",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 160],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": { "responseCode": 200 }
      }
    },
    {
      "id": "health-deep-down",
      "name": "DeepDown",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 320],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.body }}",
        "options": { "responseCode": 503 }
      }
    }
  ],
  "connections": {
    "LiveWebhook": { "main": [[{ "node": "LiveRespond", "type": "main", "index": 0 }]] },
    "DeepWebhook": { "main": [[{ "node": "Backend", "type": "main", "index": 0 }]] },
    "Backend": { "main": [[{ "node": "BotApi", "type": "main", "index": 0 }]] },
    "BotApi": { "main": [[{ "node": "Shape", "type": "main", "index": 0 }]] },
    "Shape": { "main": [[{ "node": "IsUp", "type": "main", "index": 0 }]] },
    "IsUp": {
      "main": [
        [{ "node": "DeepUp", "type": "main", "index": 0 }],
        [{ "node": "DeepDown", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none",
    "saveDataErrorExecution": "none",
    "saveExecutionProgress": false,
    "saveManualExecutions": false
  }
}
